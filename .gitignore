# 依赖
node_modules/

# 播放凭证（登录 cookie，绝不入库）
cookies.env
*.env
!*.env.example

# 开发产物
_extract/
_pack/
scripts/
*.bak
*.bak-*
*.backup
*.log
*.new
patch_*.js
__pycache__/
*.pyc

# 本地数据
bus-queue.json
bus-state.json
plugin-data/

# 发布产物（node pv/release.mjs 生成）
dist/
# 补丁账本明细（node tools/audit-patches.mjs --json 生成，结论看工具输出就行）
tools/patches-audit.json

# PV 预览台（构建产物，用 node pv/make-test.mjs 重新生成）
pv/test.html

# 拍点检测测试音（node pv/make-fixtures.mjs 生成，不入库）
pv/fixtures/

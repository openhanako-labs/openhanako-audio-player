{
  "manifestVersion": 2,
  "id": "hanako-audio-player",
  "name": "音频播放器",
  "version": "0.12.0",
  "description": "音乐播放器：本地与在线、歌词横幅、主题与动效。",
  "minAppVersion": "0.1017.0",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/ui.clipboard-write",
    "app/ui.open-external",
    "app/resources.read",
    "app/sessions.read",
    "app/sessions.manage",
    "app/session.start-turn"
  ],
  "network": {
    "allowedHosts": [
      "metingapi.nanorocky.top",
      "api.amarea.cn",
      "api.qijieya.cn",
      "met.liiiu.cn",
      "music.163.com",
      "amll-ttml-db.stevexmh.net",
      "*.music.126.net",
      "u.y.qq.com",
      "api.bilibili.com",
      "*.hdslb.com",
      "*.bilivideo.cn",
      "*.bilivideo.com"
    ],
    "methods": [
      "GET"
    ],
    "allowLocalhost": false,
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 5242880
  },
  "contributes": {
    "cards": [
      {
        "id": "player",
        "title": "音频播放器",
        "description": "播放当前曲目、查看队列与歌词。",
        "route": "/index.html",
        "face": {
          "image": "face-portrait.png"
        },
        "cardForm": "edge-to-edge",
        "detached": {
          "route": "/standalone.html"
        },
        "detachedDefaultSize": {
          "width": 1040,
          "height": 780
        },
        "titleMode": "hide"
      }
    ],
    "messageRenderers": [
      {
        "customType": "now-playing",
        "cardId": "player"
      }
    ]
  }
}
